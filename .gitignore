# IDE folders
.idea/
.vs/
.vscode/*

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
build32/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
!requirements.txt
*.exe

# For saving work files into (like IDB)
temp/

# Ignore the N64 SDK headers since we download them
# NOTE: include/PR/gbi.h and include/PR/ultratypes.h are force-tracked
# (git add -f) because they have TARGET_PC modifications for LE bitfields.
# configure.py skips download when they already exist.
include/PR/
include/gcc/
include/compiler/gcc/stdlib.h

# =============================================================================
# 3DS port additions
# NEVER commit game assets, disc images, or extracted/converted data.
# Users supply their own GAFE01 (USA Rev 0) dump.
# (orig/, build/, *.dol, *.rel, *.elf, *.map are already covered above.)
# =============================================================================

# Disc images (any format)
*.iso
*.ISO
*.gcm
*.GCM
*.ciso
*.CISO
*.rvz
*.wia
*.wbfs
*.gcz

# Archives, saves and other game-derived data
*.szs
*.arc
*.gci
*.sav
*.bin
*.t3x
*.bcwav
/rom/
/roms/
/disc/
/extracted/
/converted/
/asset_pack/
/save/
/saves/
/texture_pack/
/nes_roms/

# Reference checkouts (decomp, other PC ports, tool binaries) and their builds
/ref/

# 3DS build outputs
*.3dsx
*.cia
*.smdh
*.shbin
*.lst
*.d
build-*/

# OS noise
.DS_Store
*.swp

# Logs copied from the console (sdmc:/3ds/ac3ds/ac3ds.log)
/ac3ds*.log

# The maintainer's local notes and checklists: not published
/*_NOTES.md
/PLAYTEST.md
