; GX backend vertex shader: GX transform, texgen and lighting channel 0.
; Lighting, as emu64 configures channel 0 (selects are 0/1 per component):
;   material = matSelect ? vertex colour : matColor
;   lit      = min(ambColor + sum_i max(N.L_i, 0) * lightColor_i, 1)
;   colour   = material * (litSelect ? lit : 1)
; with L_i = normalize(lightPos_i - eyePos); disabled lights have colour 0.
; Texgen: texcoord n = texMtxN (2x4) * (texSrcNrm[n] ? (normal, 1) : (s, t, 0, 1)),
; with the raw object-space normal, as on GX (the PC port uses eye space).
; Every component of every output must be written, texcoords' z and w too:
; on hardware a half-written output hangs the GPU.

.fvec projection[4]   ; GX projection, viewport folded in, rotated for the 3DS screen (gx_uniforms.c)
.fvec modelView[4]    ; current GX position matrix
.fvec normalMtx[3]    ; current GX normal matrix (rows, xyz)
.fvec texMtx0[2]
.fvec texMtx1[2]
.fvec texSrcNrm       ; x: texcoord0 from the normal, y: texcoord1 (0 or 1)
.fvec matColor
.fvec ambColor
.fvec matSelect
.fvec litSelect
.fvec lightPos[8]     ; eye space
.fvec lightColor[8]

.constf consts(0.0, 1.0, 0.00392156862745098, 0.0) ; z = 1/255
.alias  zeros  consts.xxxx
.alias  ones   consts.yyyy
.alias  inv255 consts.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias innrm v1
.alias inclr v2
.alias intex v3

.proc main
	; r1 = eye position = modelView * vec4(inpos, 1)
	mov r0.xyz, inpos
	mov r0.w,   ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * eye
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; r4 = material = matColor + matSelect * (vertex - matColor)
	mul r3, inv255, inclr
	add r4, -matColor, r3
	mul r4, matSelect, r4
	add r4, matColor, r4

	; r5 = eye-space normal, normalized
	dp3 r5.x, normalMtx[0], innrm
	dp3 r5.y, normalMtx[1], innrm
	dp3 r5.z, normalMtx[2], innrm
	dp3 r5.w, r5, r5
	rsq r5.w, r5.w
	mul r5.xyz, r5.wwww, r5

	; texgen sources: r2 = (s, t, 0, 1); r9 = (raw normal, 1) - r2
	mov r2.xy, intex
	mov r2.z,  zeros
	mov r2.w,  ones
	mov r9.xyz, innrm
	mov r9.w,  ones
	add r9, -r2, r9

	; outtcN = texMtxN * (r2 + texSrcNrm[N] * r9)
	mad r10, r9, texSrcNrm.xxxx, r2
	dp4 outtc0.x, texMtx0[0], r10
	dp4 outtc0.y, texMtx0[1], r10
	mov outtc0.zw, consts.xxxy ; (0, 1), unused but written
	mad r10, r9, texSrcNrm.yyyy, r2
	dp4 outtc1.x, texMtx1[0], r10
	dp4 outtc1.y, texMtx1[1], r10
	mov outtc1.zw, consts.xxxy

	; r6 = ambient + sum of lights
	mov r6, ambColor

	add r7, lightPos[0], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[0], r6

	add r7, lightPos[1], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[1], r6

	add r7, lightPos[2], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[2], r6

	add r7, lightPos[3], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[3], r6

	add r7, lightPos[4], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[4], r6

	add r7, lightPos[5], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[5], r6

	add r7, lightPos[6], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[6], r6

	add r7, lightPos[7], -r1
	dp3 r7.w, r7, r7
	rsq r7.w, r7.w
	mul r7.xyz, r7.wwww, r7
	dp3 r8.x, r7, r5
	max r8.x, zeros, r8.x
	mad r6, r8.xxxx, lightColor[7], r6

	min r6, ones, r6

	; factor = 1 + litSelect * (lit - 1); outclr = material * factor
	add r6, -ones, r6
	mul r6, litSelect, r6
	add r6, ones, r6
	mul outclr, r4, r6

	end
.end
